# Cadena de conexión a PostgreSQL (Neon, Supabase u otro proveedor).
# Debe incluir sslmode=require cuando el proveedor lo exija (Neon lo exige).
DATABASE_URL=postgres://usuario:password@host:5432/basededatos?sslmode=require

# Secreto para firmar los JWT de sesión. Genera uno largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Credenciales del usuario administrador que crea el script de seed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# --- Correo para "olvidé mi contraseña" (opcional) ---
# Si no configuras estas variables, la recuperación por correo simplemente
# no envía nada (el enlace queda registrado en la base de datos, pero nadie
# lo recibe). Sirve cualquier SMTP: el de tu institución, Gmail con una
# "contraseña de aplicación", Outlook, Zoho, etc.
SMTP_HOST=smtp.tuinstitucion.edu.co
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tuinstitucion.edu.co
SMTP_PASS=clave-o-contraseña-de-aplicacion
SMTP_FROM=notificaciones@tuinstitucion.edu.co

# Opcional: fuerza la URL pública usada en el enlace del correo. Si la
# omites, se deduce automáticamente de la petición (funciona igual en
# Vercel sin configurar nada).
# NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app
